{
	"name": "git-updater",
	"description": "A plugin to automatically update GitHub, Bitbucket, GitLab, or Gitea hosted plugins, themes, and language packs.",
	"private": true,
	"devDependencies": {
		"wp-env-macos": "^2.3.0"
	},
	"scripts": {
		"test": "wp-env-macos test",
		"test:multisite": "wp-env-macos test:multisite",
		"test:coverage": "wp-env-macos test:coverage",
		"test:coverage:check": "wp-env-macos coverage:check --exclude coverage-exclude.json",
		"test:coverage:check:multisite": "wp-env-macos coverage:check --multisite --exclude coverage-exclude.json",
		"test:php80": "wp-env-macos test:php80",
		"env:start": "wp-env-macos up",
		"env:stop": "wp-env-macos down",
		"env:install": "wp-env-macos provision"
	}
}
